rules_version = '2';

// O Juris+ só acessa o Firestore pelo servidor (Admin SDK), que ignora estas
// regras. Elas existem como segunda camada de defesa: nenhum cliente (navegador)
// deve conseguir ler ou escrever direto no banco.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
