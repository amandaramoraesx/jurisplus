// Juris+ — schema do banco de dados
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Professor {
  id          String       @id @default(cuid())
  nome        String
  email       String?
  telefone    String?
  disciplinas Disciplina[]
  createdAt   DateTime     @default(now())
}

model Disciplina {
  id          String          @id @default(cuid())
  nome        String
  semestre    String
  professorId String?
  professor   Professor?      @relation(fields: [professorId], references: [id], onDelete: SetNull)
  aulas       Aula[]
  presencas   Presenca[]
  notas       Nota[]
  provas      Prova[]
  grupos      GrupoTrabalho[]
  createdAt   DateTime        @default(now())
}

model Aula {
  id                 String              @id @default(cuid())
  disciplinaId       String
  disciplina         Disciplina          @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  data               DateTime
  tema               String
  resumo             String?
  anotacoesLousa     String?
  resumoIA           String?
  favoritosVadeMecum VadeMecumFavorito[]
  createdAt          DateTime            @default(now())
}

model Presenca {
  id           String     @id @default(cuid())
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  data         DateTime
  presente     Boolean
  createdAt    DateTime   @default(now())

  @@unique([disciplinaId, data])
}

model Nota {
  id           String     @id @default(cuid())
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  descricao    String
  valor        Float
  createdAt    DateTime   @default(now())
}

model Prova {
  id           String     @id @default(cuid())
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  data         DateTime
  conteudo     String?
  createdAt    DateTime   @default(now())
}

model Palestra {
  id        String   @id @default(cuid())
  tema      String
  resumo    String?
  data      DateTime
  horas     Float
  local     String?
  createdAt DateTime @default(now())
}

model GrupoTrabalho {
  id           String            @id @default(cuid())
  tema         String
  disciplinaId String?
  disciplina   Disciplina?       @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)
  data         DateTime
  apresentacao String?
  integrantes  IntegranteGrupo[]
  createdAt    DateTime          @default(now())
}

model IntegranteGrupo {
  id      String        @id @default(cuid())
  nome    String
  grupoId String
  grupo   GrupoTrabalho @relation(fields: [grupoId], references: [id], onDelete: Cascade)
}

// Base pesquisável de legislação (seed inicial; pode crescer com o tempo)
model VadeMecumArtigo {
  id     String @id @default(cuid())
  codigo String // ex: "CF", "CC", "CP", "CPC"
  numero String // ex: "5º", "186"
  texto  String
}

// Artigos favoritados pelo usuário, opcionalmente vinculados a uma aula
model VadeMecumFavorito {
  id        String   @id @default(cuid())
  codigo    String
  numero    String
  texto     String
  aulaId    String?
  aula      Aula?    @relation(fields: [aulaId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// Inscrição de push do navegador/PWA para receber lembretes
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Registro de lembretes já enviados, para não notificar a mesma prova
// mais de uma vez para o mesmo limite de dias (ex: 7, 3, 1, 0)
model LembreteEnviado {
  id        String   @id @default(cuid())
  provaId   String
  dias      Int
  enviadoEm DateTime @default(now())

  @@unique([provaId, dias])
}
