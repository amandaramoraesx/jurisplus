# Copie este arquivo para .env e preencha os valores.

# Credenciais da Service Account do Firebase (Firestore + Auth).
# Gere em: Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Config pública do Firebase (não é segredo, usada só pelo SDK client no
# navegador pra fazer login). Console do Firebase > Configurações do projeto
# > Geral > seus apps > SDK do Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# Necessária para o resumo inteligente por IA nas aulas.
# Gere a sua em https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Chaves VAPID para notificações push (lembretes de prova).
# Gere as suas com `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seu-email@exemplo.com"

# Token secreto para proteger o endpoint que dispara os lembretes automáticos.
NOTIFICACOES_CRON_TOKEN=""
